oskar:activityId a owl:DatatypeProperty ;
    rdfs:label "activityid" ;
    rdfs:domain oskar:Activity ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.semanticprojectcontrol.com/ilap/merged/activityStatus> ;
    skos:altLabel "Aktivitäts-ID"@de ;
    skos:definition "String identifier for an activity. (Generated by AI)" .

oskar:activityName a owl:DatatypeProperty ;
    rdfs:label "activityname" ;
    rdfs:domain oskar:Activity ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.semanticprojectcontrol.com/ilap/merged/activityShortName> ;
    skos:altLabel "Aktivitätsname"@de ;
    skos:definition "Name of the activity. (Generated by AI)" .

oskar:dateAdded a owl:DatatypeProperty ;
    rdfs:label "dateadded" ;
    rdfs:domain oskar:Project ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso <http://infohub.siemens-energy.com/supplier/dateIn> ;
    skos:altLabel "Hinzugefügtes Datum"@de ;
    skos:definition "Date and time when the project was added. (Generated by AI)" .

oskar:duration a owl:DatatypeProperty ;
    rdfs:label "duration" ;
    rdfs:domain oskar:Activity ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso time:seconds ;
    skos:altLabel "Dauer"@de ;
    skos:definition "Duration of the activity in integer units. (Generated by AI)" .

oskar:finish a owl:DatatypeProperty ;
    rdfs:label "finish" ;
    rdfs:domain oskar:Activity ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso prov:endedAtTime ;
    skos:altLabel "Ende"@de ;
    skos:definition "Finish date and time of the activity. (Generated by AI)" .

oskar:physicalComplete a owl:DatatypeProperty ;
    rdfs:label "physicalcomplete" ;
    rdfs:domain oskar:Task ;
    rdfs:range xsd:float ;
    rdfs:seeAlso <https://www.semanticprojectcontrol.com/ilap/merged/actualProgress> ;
    skos:altLabel "Physischer Abschluss"@de ;
    skos:definition "Physical completion percentage of the task. (Generated by AI)" .

oskar:portfolioElementLong a owl:DatatypeProperty ;
    rdfs:label "portfolioelementlong" ;
    rdfs:domain oskar:Project ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.semanticprojectcontrol.com/ilap/merged/projectShortName> ;
