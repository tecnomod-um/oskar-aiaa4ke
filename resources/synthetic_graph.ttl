oskar:Project a owl:Class ;
    rdfs:label "project",
        "Projekt"@de,
        "Project"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oskar:projId ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty oskar:statusDate ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty oskar:dateAdded ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty oskar:projectStart ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty oskar:projectFinish ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty oskar:containsActivity ;
            owl:someValuesFrom oskar:Activity ],
        [ a owl:Restriction ;
            owl:onProperty oskar:projectId ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty oskar:projectName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty oskar:projectOverallName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty oskar:udfPcProjectname ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty oskar:scheduler ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty oskar:revAlphanumeric ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty oskar:portfolioElementShort ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty oskar:portfolioElementLong ;
            owl:someValuesFrom xsd:string ],
        <http://linked.data.gov.au/def/project#Project> ;
