@prefix base: <http://example.org/OSKAR/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix term: <http://purl.org/dc/terms/> .
@prefix element: <http://purl.org/dc/elements/1.1/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ilap: <https://www.semanticprojectcontrol.com/ilap/merged/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix se: <http://infohub.siemens-energy.com/projects#> .
@prefix sup: <http://infohub.siemens-energy.com/supplier/> .

base:ProjectActivityTaskOntology rdf:type owl:Ontology ;
    element:title "Project Activity Task Ontology" ;
    term:description "Ontology describing projects, activities, and tasks, including their attributes and relationships. (Generated by AI)" ;
    element:creator "user@email.com" ;
    term:created "2026-07-22"^^xsd:date ;
    term:issued "2026-07-22"^^xsd:date ;
    owl:versionInfo "0.0.1" ;
    vann:preferredNamespaceUri "http://example.org/OSKAR/" ;
    vann:preferredNamespacePrefix "base" ;
    owl:versionIRI <http://example.org/OSKAR/0.0.1> .

#################################################################
#    Datatype Properties
#################################################################

base:projId rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:integer ;
    rdfs:label "projid" ;
    skos:definition "Unique integer identifier for a project. (Generated by AI)" ;
    rdfs:seeAlso ilap:actualProgress .

base:projectId rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:string ;
    rdfs:label "projectid" ;
    skos:definition "String identifier for a project. (Generated by AI)" ;
    rdfs:seeAlso ilap:projectID .

base:projectName rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:string ;
    rdfs:label "projectname" ;
    skos:definition "Short name of the project. (Generated by AI)" ;
    rdfs:seeAlso ilap:projectShortName .

base:projectOverallName rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:string ;
    rdfs:label "projectoverallname" ;
    skos:definition "Overall name of the project. (Generated by AI)" ;
    rdfs:seeAlso ilap:projectShortName .

base:udfPcProjectname rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:string ;
    rdfs:label "udfpcprojectname" ;
    skos:definition "User-defined project name. (Generated by AI)" ;
    rdfs:seeAlso ilap:projectShortName .

base:scheduler rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:string ;
    rdfs:label "scheduler" ;
    skos:definition "Scheduler associated with the project. (Generated by AI)" ;
    rdfs:seeAlso ilap:projectID .

base:revAlphanumeric rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:integer ;
    rdfs:label "revalphanumeric" ;
    skos:definition "Revision alphanumeric code for the project. (Generated by AI)" ;
    rdfs:seeAlso time:numericDuration .

base:portfolioElementShort rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:string ;
    rdfs:label "portfolioelementshort" ;
    skos:definition "Short name of the portfolio element. (Generated by AI)" ;
    rdfs:seeAlso ilap:projectShortName .

base:portfolioElementLong rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:string ;
    rdfs:label "portfolioelementlong" ;
    skos:definition "Long name of the portfolio element. (Generated by AI)" ;
    rdfs:seeAlso ilap:projectShortName .

base:statusDate rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:dateTime ;
    rdfs:label "statusdate" ;
    skos:definition "Status date of the project. (Generated by AI)" ;
    rdfs:seeAlso time:inXSDDate .

base:dateAdded rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:dateTime ;
    rdfs:label "dateadded" ;
    skos:definition "Date when the project was added. (Generated by AI)" ;
    rdfs:seeAlso sup:dateIn .

base:projectStart rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:dateTime ;
    rdfs:label "projectstart" ;
    skos:definition "Start date of the project. (Generated by AI)" ;
    rdfs:seeAlso prov:startedAtTime .

base:projectFinish rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Project ;
    rdfs:range xsd:dateTime ;
    rdfs:label "projectfinish" ;
    skos:definition "Planned finish date of the project. (Generated by AI)" ;
    rdfs:seeAlso se:hasPlannedEnd .

base:activityId rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Activity ;
    rdfs:range xsd:string ;
    rdfs:label "activityid" ;
    skos:definition "String identifier for an activity. (Generated by AI)" ;
    rdfs:seeAlso ilap:TaskID .

base:activityName rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Activity ;
    rdfs:range xsd:string ;
    rdfs:label "activityname" ;
    skos:definition "Short name of the activity. (Generated by AI)" ;
    rdfs:seeAlso ilap:activityShortName .

base:start rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Activity ;
    rdfs:range xsd:dateTime ;
    rdfs:label "start" ;
    skos:definition "Start date and time of the activity. (Generated by AI)" ;
    rdfs:seeAlso prov:startedAtTime .

base:finish rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Activity ;
    rdfs:range xsd:dateTime ;
    rdfs:label "finish" ;
    skos:definition "Finish date and time of the activity. (Generated by AI)" ;
    rdfs:seeAlso prov:endedAtTime .

base:duration rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Activity ;
    rdfs:range xsd:integer ;
    rdfs:label "duration" ;
    skos:definition "Duration of the activity in integer units. (Generated by AI)" ;
    rdfs:seeAlso time:seconds .

base:totalFloatHrCnt rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Activity ;
    rdfs:range xsd:integer ;
    rdfs:label "totalfloathrcnt" ;
    skos:definition "Total float in hours for the activity. (Generated by AI)" ;
    rdfs:seeAlso ilap:totalFloat .

base:physicalComplete rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Activity ;
    rdfs:range xsd:float ;
    rdfs:label "physicalcomplete" ;
    skos:definition "Physical completion percentage of the activity. (Generated by AI)" ;
    rdfs:seeAlso ilap:actualProgress .

base:taskId rdf:type owl:DatatypeProperty ;
    rdfs:domain base:Task ;
    rdfs:range xsd:integer ;
    rdfs:label "taskid" ;
    skos:definition "Unique integer identifier for a task. (Generated by AI)" ;
    rdfs:seeAlso ilap:workingHoursADay .

#################################################################
#    Object Properties
#################################################################

base:contains rdf:type owl:ObjectProperty ;
    rdfs:domain base:Project ;
    rdfs:range base:Activity ;
    rdfs:label "contains" ;
    skos:definition "Relates a project to the activities it contains. (Generated by AI)" ;
    rdfs:seeAlso se:isActivityOf .

base:carriedOutIn rdf:type owl:ObjectProperty ;
    rdfs:domain base:Activity ;
    rdfs:range base:Task ;
    rdfs:label "carriedoutin" ;
    skos:definition "Relates an activity to the tasks in which it is carried out. (Generated by AI)" ;
    rdfs:seeAlso se:isActivityOf .

#################################################################
#    Classes
#################################################################

base:Project rdf:type owl:Class ;
    rdfs:label "project" ;
    skos:definition "A project, which consists of activities and is described by various attributes. (Generated by AI)" ;
    rdfs:subClassOf <http://linked.data.gov.au/def/project#Project> ;
    rdfs:subClassOf
        [ rdf:type owl:Restriction ;
          owl:onProperty base:projId ;
          owl:someValuesFrom xsd:integer
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:projectId ;
          owl:someValuesFrom xsd:string
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:projectName ;
          owl:someValuesFrom xsd:string
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:projectOverallName ;
          owl:someValuesFrom xsd:string
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:udfPcProjectname ;
          owl:someValuesFrom xsd:string
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:scheduler ;
          owl:someValuesFrom xsd:string
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:revAlphanumeric ;
          owl:someValuesFrom xsd:integer
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:portfolioElementShort ;
          owl:someValuesFrom xsd:string
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:portfolioElementLong ;
          owl:someValuesFrom xsd:string
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:statusDate ;
          owl:someValuesFrom xsd:dateTime
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:dateAdded ;
          owl:someValuesFrom xsd:dateTime
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:projectStart ;
          owl:someValuesFrom xsd:dateTime
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:projectFinish ;
          owl:someValuesFrom xsd:dateTime
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:contains ;
          owl:someValuesFrom base:Activity
        ] .

base:Activity rdf:type owl:Class ;
    rdfs:label "activity" ;
    skos:definition "An activity that is part of a project and is carried out in tasks. (Generated by AI)" ;
    rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ;
    rdfs:subClassOf
        [ rdf:type owl:Restriction ;
          owl:onProperty base:activityId ;
          owl:someValuesFrom xsd:string
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:activityName ;
          owl:someValuesFrom xsd:string
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:start ;
          owl:someValuesFrom xsd:dateTime
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:finish ;
          owl:someValuesFrom xsd:dateTime
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:duration ;
          owl:someValuesFrom xsd:integer
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:totalFloatHrCnt ;
          owl:someValuesFrom xsd:integer
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:physicalComplete ;
          owl:someValuesFrom xsd:float
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty base:carriedOutIn ;
          owl:someValuesFrom base:Task
        ] .

base:Task rdf:type owl:Class ;
    rdfs:label "task" ;
    skos:definition "A task in which an activity is carried out, described by its attributes. (Generated by AI)" ;
    rdfs:subClassOf <https://www.semanticprojectcontrol.com/ilap/merged/Task> ;
    rdfs:subClassOf
        [ rdf:type owl:Restriction ;
          owl:onProperty base:taskId ;
          owl:someValuesFrom xsd:integer
        ] .

#################################################################
#    End of Ontology
#################################################################
