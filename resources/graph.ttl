base:Task rdfs:subClassOf ilap:Task, _:node23;
  rdfs:label "task" .

base:Activity rdfs:subClassOf prov:Activity, _:node15, _:node16, _:node17, _:node18,
    _:node19, _:node20, _:node21, _:node22;
  rdfs:label "activity" .

base:Project rdfs:subClassOf proj:Project, _:node1, _:node2, _:node3, _:node4, _:node5,
    _:node6, _:node7, _:node8, _:node9, _:node10, _:node11, _:node12, _:node13, _:node14;
  rdfs:label "project" .

base:finish rdfs:domain base:Activity;
  rdfs:range xsd:dateTime;
  rdfs:label "finish";
  rdfs:seeAlso prov:endedAtTime .

base:duration rdfs:domain base:Activity;
  rdfs:range xsd:integer;
  rdfs:label "duration";
  rdfs:seeAlso time:seconds .

base:activityName rdfs:domain base:Activity;
  rdfs:range xsd:string;
  rdfs:label "activityname";
  rdfs:seeAlso ilap:activityShortName .

base:start rdfs:domain base:Activity;
  rdfs:range xsd:dateTime;
  rdfs:label "start";
  rdfs:seeAlso prov:startedAtTime .

base:taskId rdfs:domain base:Task;
  rdfs:range xsd:integer;
  rdfs:label "taskid";
  rdfs:seeAlso ilap:workingHoursADay .

base:totalFloatHrCnt rdfs:domain base:Activity;
  rdfs:range xsd:integer;
  rdfs:label "totalfloathrcnt";
  rdfs:seeAlso ilap:totalFloat .

base:projectName rdfs:domain base:Project;
  rdfs:range xsd:string;
  rdfs:label "projectname";
  rdfs:seeAlso ilap:projectShortName .

base:activityId rdfs:domain base:Activity;
  rdfs:range xsd:string;
  rdfs:label "activityid";
  rdfs:seeAlso ilap:TaskID .

base:portfolioElementLong rdfs:domain base:Project;
  rdfs:range xsd:string;
  rdfs:label "portfolioelementlong";
  rdfs:seeAlso ilap:projectShortName .

base:projectStart rdfs:domain base:Project;
  rdfs:range xsd:dateTime;
  rdfs:label "projectstart";
  rdfs:seeAlso prov:startedAtTime .

base:udfPcProjectname rdfs:domain base:Project;
  rdfs:range xsd:string;
  rdfs:label "udfpcprojectname";
  rdfs:seeAlso ilap:projectShortName .

base:projectId rdfs:domain base:Project;
  rdfs:range xsd:string;
  rdfs:label "projectid";
  rdfs:seeAlso ilap:projectID .

base:projectFinish rdfs:domain base:Project;
  rdfs:range xsd:dateTime;
  rdfs:label "projectfinish";
  rdfs:seeAlso seproj:hasPlannedEnd .

base:scheduler rdfs:domain base:Project;
  rdfs:range xsd:string;
  rdfs:label "scheduler";
  rdfs:seeAlso ilap:projectID .

base:dateAdded rdfs:domain base:Project;
  rdfs:range xsd:dateTime;
  rdfs:label "dateadded";
  rdfs:seeAlso sesup:dateIn .

base:revAlphanumeric rdfs:domain base:Project;
  rdfs:range xsd:integer;
  rdfs:label "revalphanumeric";
