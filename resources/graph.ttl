base:ProjectActivityTaskOntology element:title "Project Activity Task Ontology";
  term:description "Ontology describing projects, activities, and tasks, including their attributes and relationships. (Generated by AI)";
  element:creator "user@email.com";
  term:created "2026-07-25"^^xsd:date;
  term:issued "2026-07-25"^^xsd:date;
  owl:versionInfo "0.0.1";
  vann:preferredNamespaceUri "http://example.org/OSKAR/";
  vann:preferredNamespacePrefix "base";
  owl:versionIRI base:0.0.1 .

base:Task skos:definition "A task in which an activity is carried out. (Generated by AI)" .

base:finish skos:definition "Finish date and time of the activity. (Generated by AI)" .

base:duration skos:definition "Duration of the activity in integer units. (Generated by AI)" .

base:activityName skos:definition "Short name of the activity. (Generated by AI)" .

base:Activity skos:definition "An activity that is part of a project and carried out in tasks. (Generated by AI)" .

base:start skos:definition "Start date and time of the activity. (Generated by AI)" .

base:taskId skos:definition "Unique integer identifier for a task. (Generated by AI)" .

base:totalFloatHrCnt skos:definition "Total float in hours for the activity. (Generated by AI)" .

base:projectName skos:definition "Short name of the project. (Generated by AI)" .

base:activityId skos:definition "String identifier for an activity. (Generated by AI)" .

base:portfolioElementLong skos:definition "Long name for the portfolio element. (Generated by AI)" .

base:projectStart skos:definition "Start date of the project. (Generated by AI)" .

base:udfPcProjectname skos:definition "User-defined project name. (Generated by AI)" .

base:Project skos:definition "A project consisting of activities and related attributes. (Generated by AI)" .

base:projectId skos:definition "String identifier for a project. (Generated by AI)" .

base:projectFinish skos:definition "Planned finish date of the project. (Generated by AI)" .

base:scheduler skos:definition "Scheduler associated with the project. (Generated by AI)" .

base:dateAdded skos:definition "Date when the project was added. (Generated by AI)" .

base:revAlphanumeric skos:definition "Revision alphanumeric code for the project. (Generated by AI)" .

base:statusDate skos:definition "Status date of the project. (Generated by AI)" .

base:projId skos:definition "Unique integer identifier for a project. (Generated by AI)" .

base:portfolioElementShort skos:definition "Short name for the portfolio element. (Generated by AI)" .

base:projectOverallName skos:definition "Overall name of the project. (Generated by AI)" .

base:physicalComplete skos:definition "Physical completion percentage of the activity. (Generated by AI)" .

base:containsActivity skos:definition "Relates a project to the activities it contains. (Generated by AI)" .

base:carriedOutInTask skos:definition "Relates an activity to the tasks in which it is carried out. (Generated by AI)" .

